# Obsidian workspace state (per-machine, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Plugin data files (per-machine credentials / state)
.obsidian/plugins/obsidian-git/data.json
.obsidian/plugins/gemini-scribe/data.json

# System junk
.trash/
.DS_Store

# Claude Code worktrees (local only)
.claude/worktrees/

# Upload tooling: generated lint/parse payloads and bytecode
4-SYSTEM/Skills/*/scripts/linter-root-text/output/
4-SYSTEM/Skills/*/scripts/parser-root-text/output/
4-SYSTEM/Skills/*/scripts/**/__pycache__/
